{
  "name": "codetracer-js-recorder",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "CodeTracer JavaScript/TypeScript recorder — full-state recording via compile-time SWC instrumentation",
  "workspaces": [
    "packages/instrumenter",
    "packages/instrumenter-core",
    "packages/runtime",
    "packages/runtime-browser",
    "packages/cli",
    "packages/express",
    "packages/vite-plugin",
    "packages/webpack-plugin",
    "packages/esbuild-plugin",
    "packages/rollup-plugin"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest run && npm run test:verify-cli-convention && npm run test:verify-request-spans",
    "test:watch": "vitest",
    "test:verify-cli-convention": "bash tests/verify-cli-convention-no-silent-skip.sh",
    "test:verify-request-spans": "bash tests/verify-request-spans-no-silent-skip.sh"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.5.1",
    "@types/node": "^22.0.0",
    "express": "^4.21.2",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
