# Pinned toolchain versions for the codetracer-js-recorder Windows DIY
# dev environment. Consumed by ../../env.ps1.
#
# RUST_TOOLCHAIN_VERSION must match the channel in ../../rust-toolchain.toml.
RUST_TOOLCHAIN_VERSION=1.88.0
NODE_VERSION=22.13.0
JUST_VERSION=1.46.0
# Nim is needed because the recorder's native addon depends on the
# `codetracer_trace_writer_nim` crate, whose build script compiles a Nim
# static library. Keep in sync with the rest of the CodeTracer workspace.
NIM_VERSION=2.2.8
